
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "huhu-vibe",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./dist/huhu-vide/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "huhu-vibe",
      "database_id": "13b18148-9877-44dd-adf7-8def1f70c198",
      "remote": true
    }
  ]
}
